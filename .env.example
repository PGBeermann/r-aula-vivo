# =============================================================================
#  R Aula Viva — Variables de entorno (copiar en Dokploy > Environment)
#  NO suba a GitHub un archivo .env con valores reales.
# =============================================================================

# --- Clave del docente (defina UNA de las dos) -------------------------------
# Recomendado en servidor público: hash SHA-256 de la clave, en hexadecimal.
#   Linux/macOS:  printf '%s' 'MiClaveSegura' | sha256sum
#   PowerShell:   [BitConverter]::ToString([Security.Cryptography.SHA256]::Create().ComputeHash([Text.Encoding]::UTF8.GetBytes('MiClaveSegura'))).Replace('-','').ToLower()
TEACHER_KEY_SHA256=
# Alternativa (texto plano, menos segura en internet):
# TEACHER_KEY=

# --- Código de la clase para estudiantes (muy recomendado en internet) -------
# Si se define, los estudiantes deben escribirlo para entrar y poder ejecutar R.
CLASS_KEY=

# --- URL pública que se muestra en la pantalla de acceso ---------------------
PUBLIC_URL=https://raula.sudominio.com

# --- Límites de ejecución de R ----------------------------------------------
# Tiempo máximo por ejecución (ms)
R_TIMEOUT=20000
# Procesos Rscript simultáneos (por defecto: número de núcleos, mínimo 2)
MAX_CONCURRENT_R=2
# Ejecuciones en espera antes de responder "servidor ocupado"
MAX_QUEUE=60
